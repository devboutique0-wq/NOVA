                <item android:offset="0.45" android:color="#5500F0FF"/>
                <item android:offset="0.75" android:color="#228A2BE2"/>
                <item android:offset="1" android:color="#008A2BE2"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- 3D bevel depth: low-lit rear edge under the orbit ring -->
    <path android:pathData="M30.24,39.2 A29,29 0 0 1 77.76,39.2 M77.76,72.3 A29,29 0 0 1 30.24,72.3" android:strokeColor="#FF060C28" android:strokeWidth="4.2" android:strokeLineCap="round"/>
