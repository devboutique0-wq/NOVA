    <path android:pathData="M40,54 A14,14 0 1,1 68,54 A14,14 0 1,1 40,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="49" android:centerY="47"
                android:gradientRadius="22">
                <item android:offset="0" android:color="#FFFFFFFF"/>
                <item android:offset="0.3" android:color="#FF00F0FF"/>
                <item android:offset="0.75" android:color="#FF8A2BE2"/>
                <item android:offset="1" android:color="#FF2A0A66"/>
            </gradient>
        </aapt:attr>
    </path>
