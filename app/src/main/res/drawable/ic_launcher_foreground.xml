    <path android:pathData="M44.4,48.7 C46.5,43.2 53.1,41.4 58.3,44.0 C53.8,43.5 49.0,45.2 46.6,49.8 C45.8,50.5 44.8,49.8 44.4,48.7 Z" android:fillColor="#CCFFFFFF"/>
